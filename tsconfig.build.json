{
  // Declaration + JS emit for the published artifact (#940 / FR-001).
  //
  // Deliberately a *structure-preserving* `tsc` emit, not a bundle. ADR-075's
  // `ReferenceError: Prism is not defined` reproduction was a rolldown
  // whole-graph chunking artifact; introducing a second bundler here would
  // recreate that risk surface and would make the six subpaths' isolation
  // depend on chunking config that fails silently. Emitting module-for-module
  // means `./markdown` cannot acquire `./headless`'s MathJax graph, `./contract`
  // cannot acquire zod at runtime, and the `lazy(() => import('./AnnotationSurface'))`
  // boundary survives verbatim as a real dynamic import to a real file.
  //
  // `tsc-alias --resolve-full-paths` runs afterwards to turn tsc's extensionless
  // relative specifiers into Node-ESM-resolvable `./x.js` ones.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Incompatible with emit, and inert anyway — no source file imports with a
    // `.ts`/`.tsx` extension.
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx", "tests/**/*"]
}
