{
  // Declaration + JS emit for the published artifact (#940 / FR-001).
  //
  // Deliberately a *structure-preserving* `tsc` emit, not a bundle. ADR-075's
  // `ReferenceError: Prism is not defined` reproduction was a rolldown
  // whole-graph chunking artifact; introducing a second bundler here would
  // recreate that risk surface and would make the six subpaths' isolation
  // depend on chunking config that fails silently. Emitting module-for-module
  // means `./markdown` cannot acquire `./headless`'s MathJax graph, `./contract`
  // cannot acquire renderer code, and the `lazy(() => import('./AnnotationSurface'))`
  // boundary survives verbatim as a real dynamic import to a real file.
  //
  // `./contract` is NOT zod-free, and this emit does not make it so: `contract.js`
  // re-exports `./types.js`, which does `import { z } from 'zod'`, so a *value*
  // import pulls zod in. What keeps zod out of a preload boundary is `import type`
  // erasure, not the subpath — see ADR-075 §1 and ADR-078 §1. Preserving the
  // module graph preserves that property exactly as it was; it does not
  // strengthen it.
  //
  // `tsc-alias --resolve-full-paths` runs afterwards to turn tsc's extensionless
  // relative specifiers into Node-ESM-resolvable `./x.js` ones.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    // No `declarationMap`/`sourceMap`. `files` deliberately ships `dist` without
    // `src` — `verify-package.mjs` asserts no TypeScript source reaches the
    // tarball — so every emitted map would reference a `../src/*.ts` that can
    // never be there. Dangling maps are worse than none: an IDE follows the
    // declaration map to the missing source and "Go to Definition" fails
    // outright, where with no map it lands on the `.d.ts`; bundlers that read
    // dependency sourcemaps warn once per missing source. Turn these back on
    // only together with shipping `src`.
    "declarationMap": false,
    "sourceMap": false,
    // Incompatible with emit, and inert anyway — no source file imports with a
    // `.ts`/`.tsx` extension.
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx", "tests/**/*"]
}
