# Dependencies
node_modules/

# Local npm/pnpm registry override (contains personal registry/auth choices)
.npmrc

# Build outputs
dist/
*.tgz

# The examples deliberately install outside any workspace, against a packed
# tarball. Their install artifacts are per-machine and must never be committed —
# `pnpm add <tarball>` writes an absolute temp path into the manifest, which the
# scripts snapshot and restore for exactly this reason.
examples/*/node_modules/
examples/*/pnpm-lock.yaml

# Generated from the round-trip fixture corpus (docs/decisions/adr-081.md).
# Regenerated by `pnpm demo` and `pnpm build:examples` before every use, so a
# stale checked-in copy would only drift.
examples/demo/src/fixtures.generated.js

# Generated from the root README.md (docs/decisions/adr-082.md). Regenerated
# by `pnpm demo`, `pnpm build:examples` and `pnpm build:site` before every use.
examples/demo/src/docs-content.generated.js

# Electron/Vite build output and Playwright artifacts for the e2e shell.
examples/electron/dist/
examples/electron/dist-renderer/
examples/electron/test-results/
examples/electron/playwright-report/

# Test output
coverage/
*.lcov

# IDE and OS
.DS_Store
*.log
*.tmp
*.swp
*~
.vscode/settings.json

# Environment files
.env
.env.local
*.local
