{
  "compilerOptions": {
    // Mirrors the shared + renderer compiler options of the Electron application
    // this package was extracted from (verveguy/liminis#995), so that code which
    // used to live inside that renderer is held to exactly the same bar.
    "target": "ES2024",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,
    "types": ["react", "react-dom", "node"]
  },
  "include": ["src/**/*", "tests/**/*"]
}
